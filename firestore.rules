rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Strict 2-Role System: only 'admin' and 'user'
    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().role == 'admin' &&
        getUserData().is_active == true;
    }

    // --- Users & Profiles ---
    match /users/{userId} {
      // User can read own doc; Admin can view all users
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());

      // Registration: User can only create their own record as regular 'user' and active
      // Strict anti-privilege escalation at registration time
      allow create: if isSignedIn() && request.auth.uid == userId
                    && request.resource.data.role == 'user'
                    && request.resource.data.is_active == true;

      // Profile updates: User cannot self-elevate role or toggle active state
      // Admin can manage user records and toggle account activation
      allow update: if isSignedIn() && (
        (request.auth.uid == userId
          && request.resource.data.role == resource.data.role
          && request.resource.data.is_active == resource.data.is_active)
        || isAdmin()
      );

      // Account deletion: Owner can delete their own account, Admin can purge
      allow delete: if isOwner(userId) || isAdmin();

      // User Meals Subcollection (strict multi-tenant isolation)
      match /meals/{mealId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-level Profiles mapping (if used independently)
    match /profiles/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // --- Foods Catalog ---
    match /foods/{foodId} {
      // Food catalog is readable by everyone; Modification strictly restricted to Administrators
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- CMS Articles ---
    match /cms_articles/{articleId} {
      // Articles are readable by everyone; Manage by Administrators
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- CMS Categories ---
    match /cms_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- CMS Announcements ---
    match /cms_announcements/{announcementId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // --- CMS Audit Logs ---
    match /cms_audit_logs/{logId} {
      // Only Admin can read audit trail
      allow read: if isAdmin();
      // Any Administrator can record audit events for their own actions
      allow create: if isAdmin() && request.resource.data.performed_by == request.auth.uid;
      // Audit logs are completely immutable once created
      allow update, delete: if false;
    }

    // --- CMS Media Assets ---
    match /cms_media/{mediaId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
