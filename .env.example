# ==============================================================================
# OopsieEats — Environment Configuration Template (.env.example)
# ==============================================================================
# Gunakan nilai-nilai ini sebagai argumen --dart-define saat menjalankan
# atau membangun aplikasi Flutter:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://<your-project-ref>.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=<your-supabase-publishable-key>
#
# ==============================================================================

# Supabase Storage Configuration (Opsional - untuk upload foto inspeksi makanan & profil)
# Nilai default di source code adalah kosong (graceful degradation ke local storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Dedicated private storage bucket (default: food-history-images)
SUPABASE_BUCKET=food-history-images
