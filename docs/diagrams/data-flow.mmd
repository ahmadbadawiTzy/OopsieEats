    classDef ui fill:#E8F1FF,stroke:#2B6CB0,stroke-width:2px,color:#1A365D;
    classDef state fill:#FAF5FF,stroke:#805AD5,stroke-width:2px,color:#321A63;
    classDef core fill:#FFF5F5,stroke:#E53E3E,stroke-width:2px,color:#63171B;
    classDef repo fill:#F0FFF4,stroke:#38A169,stroke-width:2px,color:#1C4532;
    classDef storage fill:#FFF2E8,stroke:#DD6B20,stroke-width:2px,color:#7B341E;

    class UserInput,ConsumerWidget ui;
    class ProviderMethod,NotifyListeners state;
    class ComputeEngine core;
    class RepoMethod,DTO repo;
    class FirestoreDB,SupabaseStore,LocalCache storage;
