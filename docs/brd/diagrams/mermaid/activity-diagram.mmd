%% Diagram 7: UML Activity Diagram with Swimlanes — Food Scan & Logging Flow
flowchart TB
    subgraph UserLane ["👤 PENGGUNA"]
        U1["Mulai: Buka Kamera / Pilih Galeri"]
        U2["Tinjau Hasil Deteksi (Kotak Pembatas & Nama Makanan)"]
        U3["Konfirmasi Pangan & Atur Bobot Gram Porsi"]
        U4["Melihat Dashboard & Riwayat Terbarui"]
    end

    subgraph UILane ["📱 FLUTTER UI THREAD"]
        L1["Tangkap Foto via image_picker"]
        L2["Kirim Raw Bytes ke Background Isolate"]
        L3["Terima Bounding Boxes & Confidence Scores"]
        L4["Tampilkan DetectionConfirmationScreen"]
        L5["Kirim Citra ke SupabaseStorageService"]
        L6["Panggil MealRepository.createMeal()"]
        L7["Perbarui State Provider (Dashboard & History)"]
    end

    subgraph IsolateLane ["⚡ WORKER ISOLATE (EDGE AI)"]
        I1["Decode Citra & Koreksi Rotasi EXIF"]
        I2["Resize Linier ke 640 x 640 Piksel"]
        I3["Normalisasi RGB Float32 [1, 3, 640, 640]"]
        I4["Eksekusi Interpreter TFLite (best.tflite)"]
        I5["Non-Maximum Suppression (IoU 0.45, Conf >= 0.15)"]
        I6["Petakan ID Kelas ke 29 Pangan Indonesia"]
    end

    subgraph SupabaseLane ["☁️ SUPABASE CLOUD STORAGE"]
        S1["Kompres Citra (Max 1024px JPEG 80%)"]
        S2["Simpan ke Bucket 'food-history-images/{uid}/{mealId}.jpg'"]
        S3["Terbitkan Time-Limited Signed URL (TTL 1 Jam)"]
    end

    subgraph FirestoreLane ["🔥 CLOUD FIRESTORE & CACHE"]
        F1["Simpan Dokumen ke users/{uid}/meals/{mealId}"]
        F2["Validasi Aturan Keamanan (request.auth.uid == userId)"]
        F3["Perbarui Bounded Local SQLite Cache (100 MB)"]
        F4["Pancarkan Snapshot Stream Real-Time"]
    end

    U1 --> L1
    L1 --> L2
    L2 --> I1
    I1 --> I2 --> I3 --> I4 --> I5 --> I6
    I6 --> L3
    L3 --> L4
    L4 --> U2
    U2 --> U3
    U3 --> L5
    L5 --> S1
    S1 --> S2 --> S3
    S3 --> L6
    L6 --> F1
    F1 --> F2 --> F3 --> F4
    F4 --> L7
    L7 --> U4

    classDef uNode fill:#F3F4F6,stroke:#4B5563,color:#111827;
    classDef lNode fill:#E8EEF8,stroke:#3B82F6,color:#1E3A8A;
    classDef iNode fill:#FEF3C7,stroke:#D97706,color:#92400E;
    classDef sNode fill:#EFF6FF,stroke:#2563EB,color:#1E40AF;
    classDef fNode fill:#ECFDF5,stroke:#10B981,color:#065F46;

    class U1,U2,U3,U4 uNode;
    class L1,L2,L3,L4,L5,L6,L7 lNode;
    class I1,I2,I3,I4,I5,I6 iNode;
    class S1,S2,S3 sNode;
    class F1,F2,F3,F4 fNode;
