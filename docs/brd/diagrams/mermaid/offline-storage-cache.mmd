%% Diagram 14: Offline Storage, Caching, and Data Synchronization Architecture — OopsieEats
flowchart TB
    subgraph ClientLayers ["MOBILE APPLICATION (OopsieEats Client)"]
        UI["UI Layer / Consumer Widgets\n(Dashboard, Meal History, Scanner)"]
        Repo["Repository & Service Layer\n(AuthRepo, MealRepo, FoodRepo, SupaStorage)"]
    end

    subgraph SecurityStorage ["1. HARDWARE-BACKED SECURE STORAGE"]
        direction TB
        FSS["FlutterSecureStorage Wrapper (ApiClient)"]
        AndroidSec["Android: EncryptedSharedPreferences\nMasterKey in Android KeyStore (AES-256 GCM)"]
        IOSSec["iOS: Keychain Services\nkSecAttrAccessibleAfterFirstUnlockThisDeviceOnly"]
        SecPayloads["Secured Payloads:\n• Supabase Anon/Service JWT\n• Biometric Auth State Flags\n• Encrypted Device Session IDs"]
        FSS --> AndroidSec
        FSS --> IOSSec
        AndroidSec --> SecPayloads
        IOSSec --> SecPayloads
    end

    subgraph FirestorePersistence ["2. CLOUD FIRESTORE OFFLINE PERSISTENCE"]
        direction TB
        FSClient["FirebaseFirestore SDK Client"]
        SettingsConfig["Settings(persistenceEnabled: true,\ncacheSizeBytes: 104857600) [100 MB Cap]"]
        SQLiteCache["Local SQLite Database Cache\n(Read/Write Log, Pending Mutations)"]
        SyncEngine["Firestore Sync & Reconnection Engine\n(Last-Write-Wins via serverTimestamp())"]
        FSClient --> SettingsConfig
        SettingsConfig --> SQLiteCache
        SQLiteCache <--> SyncEngine
    end

    subgraph StaticBundle ["3. IMMUTABLE ASSET SEED FALLBACK"]
        direction TB
        BundleReader["AssetBundle (rootBundle.loadString)"]
        SeedJSON["assets/data/seed_foods.json\n(29 Indonesian Pangan TKPI 2020)"]
        FallbackLogic["FoodRepository Cache Miss Handler\n(Zero-Network Food Catalog Guarantee)"]
        BundleReader --> SeedJSON
        SeedJSON --> FallbackLogic
    end

    subgraph MediaCacheLayer ["4. MEDIA & TEMPORARY FILE CACHE"]
        direction TB
        CameraTemp["Camera Capture Temp Storage\nDirectory.systemTemp / XFile (di bawah 5 MB)"]
        ImgCompressor["flutter_image_compress (JPEG 85%, Max 1080p)\nAuto-purge upon upload completion"]
        ImageNetCache["CachedNetworkImageProvider\n(Disk LRU + In-Memory Bitmap Cache)\nAvatar & Food Thumbnails (Signed URL 3600s TTL)"]
        CameraTemp --> ImgCompressor
    end

    subgraph RemoteBackend ["5. REMOTE CLOUD BACKENDS"]
        CloudFirestore["Cloud Firestore (asia-southeast2)\nusers/:uid/meals & foods collections"]
        CloudStorage["Supabase Storage (ap-southeast-1)\nfood-history-images (Private Bucket + RLS)"]
    end

    %% Flow connections
    UI <--> Repo
    Repo -->|"Credentials & Keys"| FSS
    Repo -->|"Structured Data CRUD"| FSClient
    Repo -->|"Catalog Offline Fallback"| FallbackLogic
    Repo -->|"Camera Photos & Avatars"| MediaCacheLayer

    SyncEngine <-->|"Bi-directional Sync on Network Reconnect"| CloudFirestore
    ImgCompressor -->|"Encrypted TLS 1.3 Upload"| CloudStorage
    ImageNetCache -->|"Fetch via Signed URL"| CloudStorage

    classDef client fill:#E8EEF8,stroke:#3B82F6,color:#1E3A8A,stroke-width:1.5px;
    classDef sec fill:#FEF3C7,stroke:#D97706,color:#92400E,stroke-width:1.5px;
    classDef fs fill:#ECFDF5,stroke:#10B981,color:#065F46,stroke-width:1.5px;
    classDef asset fill:#F3E8FF,stroke:#8B5CF6,color:#4C1D95,stroke-width:1.5px;
    classDef media fill:#FFE4E6,stroke:#F43F5E,color:#881337,stroke-width:1.5px;
    classDef remote fill:#F1F5F9,stroke:#64748B,color:#0F172A,stroke-width:1.5px;

    class UI,Repo client;
    class FSS,AndroidSec,IOSSec,SecPayloads sec;
    class FSClient,SettingsConfig,SQLiteCache,SyncEngine fs;
    class BundleReader,SeedJSON,FallbackLogic asset;
    class CameraTemp,ImgCompressor,ImageNetCache media;
    class CloudFirestore,CloudStorage remote;
