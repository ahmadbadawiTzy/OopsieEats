    classDef data fill:#ECFDF5,stroke:#10B981,color:#065F46,stroke-width:1.5px;
    classDef infra fill:#F3F4F6,stroke:#6B7280,color:#111827,stroke-width:1.5px;

    class PresentationLayer,Screens,SharedWidgets pres;
    class StateLayer,AuthProvider,DashboardProvider,ScanFlowProvider,MealHistoryProvider,ProfileProvider,AdminProvider state;
    class CoreLayer,YoloDetector,NutritionCalc,AgeCalc core;
    class DataLayer,AuthRepo,MealRepo,FoodRepo,ProfileRepo,AdminRepo,SupaStorage,ApiClient data;
    class InfraLayer,LocalSec,LocalCache,LocalSeed,CloudFirebase,CloudSupabase infra;
