%% Diagram 3: Application Architecture Diagram (Layered & Modular) — OopsieEats
flowchart TB
    subgraph PresentationLayer ["1. PRESENTATION LAYER (UI & WIDGETS)"]
        direction TB
        subgraph Screens ["Screens"]
            AuthScreens["Auth: Onboarding, Login, Register, CompleteProfile"]
            DashScreens["Dashboard: Hero Calorie Dial, Bento Grid, Daily Intake"]
            ScanScreens["Scanner: Camera Viewfinder, DetectionConfirm, PortionInput"]
            MealScreens["Meals: MealHistory, MealDetail, DeleteModal"]
            ProfileScreens["Profile: PersonalMetrics, AvatarCatalog, AboutScreen"]
            AdminScreens["Admin: FoodManagement, ArticleEditor, AuditViewer"]
        end
        subgraph SharedWidgets ["Design System (Overkill Neo-Brutalism)"]
            NeoTokens["NeoTokens: Hard Shadows, Bold 2-3px Borders, Cream Canvas"]
            NeoComponents["NeoButton, NeoCard, NeoInput, NeoBottomNav, AvatarWidget"]
        end
    end

    subgraph StateLayer ["2. BUSINESS LOGIC & STATE MANAGEMENT (Provider v6.1.2)"]
        AuthProvider["AuthProvider (Sesi, Biometrik, Complete Profile Guard)"]
        DashboardProvider["DashboardProvider (Tanggal Aktif, Agregasi Intake vs Target)"]
        ScanFlowProvider["ScanFlowProvider (Pipeline Kamera, Seleksi Porsi)"]
        MealHistoryProvider["MealHistoryProvider (Paginasi Riwayat & Filter)"]
        ProfileProvider["ProfileProvider (Kalkulasi Target Mifflin-St Jeor)"]
        AdminProvider["AdminProvider (Manajemen Katalog & Validasi Atwater)"]
    end

    subgraph CoreLayer ["3. CORE COMPUTE ENGINE (Dart / Isolate)"]
        YoloDetector["YoloDetector (Background Isolate via Isolate.run)\n• best.tflite (9.4 MB) • Normalisasi Float32 [1, 3, 640, 640]\n• Non-Maximum Suppression (IoU 0.45, Score >= 0.15)"]
        NutritionCalc["NutritionCalculator (Deterministik)\n• Mifflin-St Jeor (BMR & TDEE) • Safe Calorie Floor\n• Verifikasi Faktor Atwater (4P + 4C + 9F)"]
        AgeCalc["AgeCalculator (Kalkulasi Usia Dinamis)"]
    end

    subgraph DataLayer ["4. DATA REPOSITORY & SERVICE LAYER"]
        AuthRepo["AuthRepository (Firebase Auth & Session)"]
        MealRepo["MealRepository (users/{uid}/meals CRUD)"]
        FoodRepo["FoodRepository (Katalog foods, Seed Fallback)"]
        ProfileRepo["ProfileRepository (Profil Firestore Sync)"]
        AdminRepo["AdminRepository (CMS & Immutable Audit)"]
        SupaStorage["SupabaseStorageService (Kompresi & Signed URLs)"]
        ApiClient["ApiClient (FlutterSecureStorage Hardware Wrapper)"]
    end

    subgraph InfraLayer ["5. PERSISTENSI & CLOUD BACKEND"]
        LocalSec["Hardware KeyStore/Keychain (AES-256)"]
        LocalCache["Bounded Firestore SQLite Cache (100 MB)"]
        LocalSeed["Asset Bundle: seed_foods.json (29 Pangan)"]
        CloudFirebase["Cloud Firestore (asia-southeast2) & Firebase Auth"]
        CloudSupabase["Supabase Object Storage (ap-southeast-1)"]
    end

    PresentationLayer --> StateLayer
    StateLayer --> CoreLayer
    StateLayer --> DataLayer
    DataLayer --> InfraLayer

    classDef pres fill:#E8EEF8,stroke:#3B82F6,color:#1E3A8A,stroke-width:1.5px;
