%% Figure 5: Cloud Firestore Document Schema Model (ERD) & Supabase Storage
%% Standar: NoSQL Document Model ERD, OopsieEats
flowchart LR
    subgraph UsersCol ["users/{userId} — Dokumen Profil & Target"]
        direction TB
        USERS["<b>users/{userId}</b><hr/><div style='text-align:left; min-width:260px;'>+ uid: string (PK / Auth UID)<br/>+ email: string<br/>+ full_name: string<br/>+ role: 'user' | 'admin'<br/>+ is_active: boolean<br/>+ avatar_preset: string<br/>+ profile_photo_url: string (opsional)<br/>+ profile: map<br/>&nbsp;&nbsp;• age: int<br/>&nbsp;&nbsp;• gender: 'male' | 'female'<br/>&nbsp;&nbsp;• height_cm: double<br/>&nbsp;&nbsp;• weight_kg: double<br/>&nbsp;&nbsp;• activity_level: string<br/>&nbsp;&nbsp;• goal: 'lose' | 'maintain' | 'gain'<br/>+ daily_target: map<br/>&nbsp;&nbsp;• calories_kcal: int<br/>&nbsp;&nbsp;• protein_g: double<br/>&nbsp;&nbsp;• carbs_g: double<br/>&nbsp;&nbsp;• fat_g: double<br/>&nbsp;&nbsp;• bmr_kcal: double<br/>&nbsp;&nbsp;• tdee_kcal: double<br/>&nbsp;&nbsp;• formula: 'mifflin_st_jeor'</div>"]
    end

    subgraph MealsCol ["users/{userId}/meals/{mealId} — Subkoleksi Catatan Makan"]
        direction TB
        MEALS["<b>users/{userId}/meals/{mealId}</b><hr/><div style='text-align:left; min-width:270px;'>+ id: string (PK / timestamp id)<br/>+ meal_type: 'breakfast'|'lunch'|'dinner'|'snack'<br/>+ consumed_date: string (YYYY-MM-DD, Index)<br/>+ consumed_at: timestamp (Index)<br/>+ image_path: string (Supabase Bucket Path)<br/>+ items: array&lt;map&gt;<br/>&nbsp;&nbsp;• food_id: int<br/>&nbsp;&nbsp;• food_name: string<br/>&nbsp;&nbsp;• portion_grams: double<br/>&nbsp;&nbsp;• calories: double<br/>&nbsp;&nbsp;• protein_g: double<br/>&nbsp;&nbsp;• carbs_g: double<br/>&nbsp;&nbsp;• fat_g: double<br/>&nbsp;&nbsp;• confidence: double<br/>+ totals: map<br/>&nbsp;&nbsp;• calories: double<br/>&nbsp;&nbsp;• protein: double<br/>&nbsp;&nbsp;• carbs: double<br/>&nbsp;&nbsp;• fat: double<br/>+ created_at: timestamp</div>"]
    end

    subgraph FoodsCol ["foods/{foodId} — Master Katalog Pangan (TKPI 2020)"]
        direction TB
        FOODS["<b>foods/{foodId}</b><hr/><div style='text-align:left; min-width:250px;'>+ id: int (PK / Kode Pangan)<br/>+ name: string (Nama Pangan Indonesia)<br/>+ yolo_class: string (Label YOLO26n)<br/>+ is_active: boolean<br/>+ calories_kcal_per_100g: double<br/>+ protein_g_per_100g: double<br/>+ carbs_g_per_100g: double<br/>+ fat_g_per_100g: double<br/>+ source: 'TKPI 2020'<br/>+ verified_atwater: boolean</div>"]
    end

    subgraph CMSCol ["cms_articles & cms_audit_logs — Konten & Audit"]
        direction TB
        ARTICLES["<b>cms_articles/{articleId}</b><hr/><div style='text-align:left; min-width:240px;'>+ id: string (PK)<br/>+ title: string<br/>+ slug: string (Unik)<br/>+ status: 'published' | 'draft'<br/>+ cover_image_url: string<br/>+ author_name: string<br/>+ category: string<br/>+ excerpt: string<br/>+ content: string<br/>+ read_time_minutes: int<br/>+ created_at: timestamp</div>"]

        AUDIT["<b>cms_audit_logs/{logId}</b><hr/><div style='text-align:left; min-width:240px;'>+ id: string (PK)<br/>+ action: string<br/>+ performed_by: string (UID Admin)<br/>+ target_collection: string<br/>+ target_id: string<br/>+ timestamp: timestamp</div>"]
    end

    subgraph StorageBucket ["Supabase Storage — Private Bucket"]
        direction TB
        STORAGE["<b>food-history-images (Bucket)</b><hr/><div style='text-align:left; min-width:240px;'>+ {userId}/{mealId}.jpg<br/>• Row-Level Security: Auth UID<br/>• Akses: Time-Limited Signed URL (1 Jam)<br/>• Kompresi: Max 1024px JPEG (80% Quality)</div>"]
    end

    %% Relasi Data
    USERS == "1 : N (Subkoleksi Privat)" ==> MEALS
    FOODS -. "Direferensikan pada items[].food_id" .-> MEALS
    MEALS -. "image_path mereferensikan object" .-> STORAGE
    USERS -. "performed_by mencatat UID Admin" .-> AUDIT

